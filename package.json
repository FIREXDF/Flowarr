{
  "name": "flowarr",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter ./packages/** build && pnpm --parallel --filter @flowarr/server --filter @flowarr/web dev",
    "reset-password": "pnpm --filter @flowarr/server reset-password",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
