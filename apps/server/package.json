{
  "name": "@flowarr/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^8.2.0",
    "@flowarr/ffmpeg": "workspace:*",
    "@flowarr/flow-engine": "workspace:*",
    "@flowarr/plugin-sdk": "workspace:*",
    "@flowarr/shared": "workspace:*",
    "fastify": "^5.6.0"
  },
  "devDependencies": { "@types/node": "^24.3.0", "tsx": "^4.20.5", "typescript": "^5.9.2" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "reset-password": "tsx src/reset-password.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @flowarr/flow-engine --filter @flowarr/ffmpeg build",
    "test": "tsx --test src/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}
